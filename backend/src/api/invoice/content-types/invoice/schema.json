{
  "kind": "collectionType",
  "collectionName": "invoices",
  "info": {
    "singularName": "invoice",
    "pluralName": "invoices",
    "displayName": "invoice"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "invoice_nro": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "issue_date": {
      "type": "datetime",
      "required": true
    },
    "subtotal": {
      "type": "decimal",
      "required": true
    },
    "taxes": {
      "type": "decimal"
    },
    "total": {
      "type": "decimal",
      "required": true
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "required": false
    },
    "paid": {
      "type": "decimal",
      "required": true,
      "default": 0
    },
    "payments": {
      "type": "component",
      "component": "component.payment",
      "repeatable": true
    },
    "discounts": {
      "type": "decimal",
      "required": true,
      "default": 0
    },
    "detail": {
      "type": "string"
    },
    "state": {
      "type": "enumeration",
      "required": true,
      "default": "PENDIENTE",
      "enum": [
        "PENDIENTE",
        "PAGADA",
        "PARCIAL"
      ]
    },
    "payment_date": {
      "type": "datetime",
      "required": false
    },
    "issuer_data": {
      "type": "component",
      "component": "component.issuer-data",
      "repeatable": false,
      "required": false
    },
    "invoice_item": {
      "type": "component",
      "component": "component.invoice-item",
      "repeatable": true
    },
    "cliente": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cliente.cliente",
      "inversedBy": "invoices"
    }
  }
}
